# Copy this file to .env, then pick ONE model option below. .env is git-ignored.

# --- Option A (free): Google Gemini free tier. Key from https://aistudio.google.com/apikey
OFFERPILOT_MODEL=gemini/gemini-flash-latest
GEMINI_API_KEY=your-key-here

# --- Option B (free, runs on your computer): Ollama. Install from https://ollama.com,
# --- then run: ollama pull qwen3:8b
# OFFERPILOT_MODEL=ollama/qwen3:8b

# --- Option C (paid): Anthropic Claude. Key from https://console.anthropic.com
# OFFERPILOT_MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=your-key-here

# Optional: live web search for the Company Researcher (free key at https://serper.dev).
SERPER_API_KEY=
